# Example overrides that rebuild adamescj's light config on top of Sqooky's default.
# Use it with:  python gameinfo_updater.py update --overrides overrides.light.gi
# (or just use --config light, which already has these baked in)

# force commented out = back to the game's defaults
// sc_fade_distance_scale_override
// sc_screen_size_lod_scale_override
// r_size_cull_threshold
// r_farz
// r_mapextents
// lb_enable_baked_shadows
// lb_enable_stationary_lights

# force lock value
r_aspectratio 2.2
